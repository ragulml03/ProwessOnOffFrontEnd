<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LaunchDarkly.ServerSdk" Version="8.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.6" />
  </ItemGroup>

  <!--
    React SPA Build Target
    Runs automatically on `dotnet publish` (not on every `dotnet build`
    so development stays fast). To build manually during development:
      cd ClientApp && npm install && npm run build
  -->
  <Target Name="BuildReactSpa" BeforeTargets="Publish" Condition="Exists('$(MSBuildProjectDirectory)/ClientApp/package.json')">
    <Message Text="[OffOn] Installing React dependencies..." Importance="high" />
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" Condition="!Exists('$(MSBuildProjectDirectory)/ClientApp/node_modules')" />
    <Message Text="[OffOn] Building React SPA → wwwroot/app" Importance="high" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" />
  </Target>

</Project>
