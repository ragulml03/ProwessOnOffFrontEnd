@model ProfileViewModel
@{ ViewData["Title"] = "Profile"; }

<section class="pt-12 pb-28 px-6">
    <div class="max-w-5xl mx-auto">

        <div class="flex flex-col md:flex-row items-start md:items-center gap-6 mb-10">
            <div class="w-16 h-16 rounded-2xl bg-[#405BFF] flex items-center justify-center text-xl font-bold text-white shrink-0">
                @Model.User.AvatarInitials
            </div>
            <div>
                <h1 class="text-2xl font-bold text-white">@Model.User.Name</h1>
                <p class="text-white/40 text-sm mt-0.5">@Model.User.Email</p>
            </div>
            <div class="md:ml-auto flex items-center gap-3">
                <span class="text-xs font-semibold text-[#405BFF] bg-[#405BFF]/10 border border-[#405BFF]/25 px-3 py-1.5 rounded-full uppercase tracking-wider">
                    @Model.User.Plan
                </span>
                <span class="text-xs font-semibold text-white/50 bg-white/5 border border-white/10 px-3 py-1.5 rounded-full">
                    @Model.User.Role
                </span>
            </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
            @foreach (var stat in Model.Stats)
            {
                <div class="bg-white/3 border border-white/8 rounded-xl p-5">
                    <p class="text-3xl font-bold text-white mb-1">@stat.Value</p>
                    <p class="text-white/40 text-sm">@stat.Label</p>
                </div>
            }
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 bg-white/3 border border-white/8 rounded-xl overflow-hidden">
                <div class="px-6 py-4 border-b border-white/8 flex items-center justify-between">
                    <h2 class="font-semibold text-sm">Recent Feature Flags</h2>
                    <a asp-controller="Careers" asp-action="Index" class="text-xs text-[#405BFF] hover:text-white/70 transition-colors">View all</a>
                </div>
                <div class="divide-y divide-white/5">
                    @foreach (var flag in Model.RecentFlags)
                    {
                        <div class="px-6 py-4 flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-2 h-2 rounded-full shrink-0 @(flag.Status == "On" ? "bg-green-400" : "bg-white/20")"></div>
                                <span class="text-sm font-mono text-white/80 truncate">@flag.Name</span>
                            </div>
                            <div class="flex items-center gap-3 shrink-0 text-sm text-white/35">
                                <span class="text-xs bg-white/5 border border-white/8 px-2 py-0.5 rounded">@flag.Environment</span>
                                <span>@flag.UpdatedAt</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="bg-white/3 border border-white/8 rounded-xl p-6">
                <h2 class="font-semibold text-sm mb-5">Account Details</h2>
                <div class="space-y-4">
                    <div>
                        <p class="text-xs text-white/30 uppercase tracking-wider mb-1">Member Since</p>
                        <p class="text-sm text-white/70">@Model.User.JoinDate</p>
                    </div>
                    <div>
                        <p class="text-xs text-white/30 uppercase tracking-wider mb-1">Current Plan</p>
                        <p class="text-sm text-white/70">@Model.User.Plan</p>
                    </div>
                    <div>
                        <p class="text-xs text-white/30 uppercase tracking-wider mb-1">Role</p>
                        <p class="text-sm text-white/70">@Model.User.Role</p>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-white/8 space-y-2.5">
                    <button class="w-full text-sm bg-[#405BFF] hover:bg-[#3350EE] text-white py-2.5 rounded-lg font-medium transition-colors">
                        Edit Profile
                    </button>
                    <button class="w-full text-sm border border-white/10 hover:border-white/25 text-white/50 hover:text-white py-2.5 rounded-lg transition-colors">
                        Manage Billing
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>
