@model HomeViewModel
@{ ViewData["Title"] = "Home"; }

<section class="relative pt-28 pb-32 px-6 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#405BFF]/8 via-transparent to-transparent pointer-events-none"></div>
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-[#405BFF]/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-[#405BFF]/10 border border-[#405BFF]/30 text-[#405BFF] text-xs font-semibold px-4 py-2 rounded-full mb-8 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 bg-[#405BFF] rounded-full animate-pulse"></span>
            Feature Flag Platform
        </div>

        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight tracking-tight">
            @Model.HeroTitle
        </h1>
        <p class="text-lg md:text-xl text-white/50 mb-10 max-w-2xl mx-auto leading-relaxed">
            @Model.HeroSubtitle
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="@Model.HeroCtaLink"
               class="bg-[#405BFF] hover:bg-[#3350EE] text-white px-8 py-3.5 rounded-lg font-semibold transition-colors duration-150 text-sm">
                @Model.HeroCtaText
            </a>
            <a asp-controller="About" asp-action="Index"
               class="border border-white/20 hover:border-white/40 text-white/70 hover:text-white px-8 py-3.5 rounded-lg font-semibold transition-colors duration-150 text-sm">
                Learn More
            </a>
        </div>
    </div>
</section>

<section class="py-24 px-6 bg-[#012B5E]/20 border-y border-white/5">
    <div class="max-w-7xl mx-auto">
        <p class="text-center text-white/30 text-sm font-semibold uppercase tracking-widest mb-12">
            Trusted by engineering teams everywhere
        </p>
        <div class="flex flex-wrap justify-center items-center gap-12 text-white/20 font-bold text-lg">
            <span>Acme Corp</span>
            <span>Vercel</span>
            <span>Stripe</span>
            <span>Notion</span>
            <span>Linear</span>
            <span>Figma</span>
        </div>
    </div>
</section>

<section class="py-28 px-6">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Everything you need to ship with confidence</h2>
            <p class="text-white/50 max-w-xl mx-auto">One platform. Every tool your team needs to deploy, test, and control features at scale.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            @foreach (var f in Model.Features)
            {
                <div class="group bg-white/3 border border-white/8 rounded-xl p-6 hover:bg-[#405BFF]/8 hover:border-[#405BFF]/30 transition-all duration-200 cursor-default">
                    <div class="text-3xl mb-5 grayscale group-hover:grayscale-0 transition-all">@f.Icon</div>
                    <h3 class="text-base font-semibold mb-2 text-white">@f.Title</h3>
                    <p class="text-white/50 text-sm leading-relaxed">@f.Description</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-24 px-6 bg-gradient-to-r from-[#405BFF]/10 to-[#001E41] border-y border-white/5">
    <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to ship smarter?</h2>
        <p class="text-white/50 mb-8">Join hundreds of teams already using OffOn to deliver better software, faster.</p>
        <a asp-controller="Profile" asp-action="Index"
           class="inline-block bg-[#405BFF] hover:bg-[#3350EE] text-white px-8 py-3.5 rounded-lg font-semibold transition-colors duration-150 text-sm">
            Open Your Dashboard
        </a>
    </div>
</section>
