    </script>
    <!-- End VWO Async SmartCode -->

    @*
        STEP 3 — VWO "Sticker System": tag the user with their platform
        and manually activate the careers campaign on the relevant page.
        Replace YOUR_CAREERS_CAMPAIGN_ID with the numeric campaign ID from
        VWO Dashboard → Campaigns → (your campaign) → Settings.
    *@
    <script>
    (function () {
        function activateVwo() {
            var d = window.AB_TEST_DATA;
            if (!d) return;

            window.VWO = window.VWO || [];

            // Tag user so every VWO report can be sliced by platform.
            window.VWO.push(["tag", "Platform_Version", d.platform_version]);
            window.VWO.push(["tag", "Migration_Group", d.migration_group]);

            // Activate campaigns by URL — add more paths as migration grows.
            var path = window.location.pathname.toLowerCase();
            if (path === "/careers" || path === "/app/careers") {
                // Manual activation: VWO assigns variation but does NOT
                // apply visual changes automatically (we do it in React/Razor).
                window.VWO.push(["activate", 4]);
            }
        }

        // Queue the callback so it runs after VWO settings have been fetched.
        window._vis_opt_queue = window._vis_opt_queue || [];
        window._vis_opt_queue.push(activateVwo);
    }());
    </script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        space: '#001E41',
                        'space-mid': '#012B5E',
                        electric: '#405BFF',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-space text-white min-h-screen flex flex-col antialiased">

    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#001E41]/90 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <a asp-controller="Home" asp-action="Index" class="text-xl font-bold tracking-tight select-none">
                Off<span class="text-[#405BFF]">On</span>
            </a>
            <nav class="flex items-center gap-6">
                <a asp-controller="Home" asp-action="Index"
                   class="text-sm text-white/60 hover:text-white transition-colors duration-150">Home</a>
                <a asp-controller="Home" asp-action="About"
                   class="text-sm text-white/60 hover:text-white transition-colors duration-150">About</a>
                <a href="@careersHref"
                   class="text-sm text-white/60 hover:text-white transition-colors duration-150">Careers</a>
                <a href="@profileHref"
                   class="text-sm bg-[#405BFF] hover:bg-[#3350EE] text-white px-4 py-2 rounded-lg transition-colors duration-150 font-medium">
                    Profile
                </a>
            </nav>
        </div>
    </header>

    <main class="flex-1">
        @RenderBody()
    </main>

    <footer class="border-t border-white/10 py-10 mt-20">
        <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
            <span class="text-xl font-bold">Off<span class="text-[#405BFF]">On</span></span>
            <p class="text-white/30 text-sm">© 2025 OffOn Inc. All rights reserved.</p>
            <div class="flex gap-6 text-sm text-white/40">
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-white/70 transition-colors">Privacy</a>
                <a href="#" class="hover:text-white/70 transition-colors">Terms</a>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
