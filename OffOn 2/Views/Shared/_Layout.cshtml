@using Microsoft.Extensions.Options
@using Microsoft.Extensions.Configuration
@using OffOn.Models
@using OffOn.Services
@inject IOptions<MigrationSettings> MigrationOptions
@inject IConfiguration Configuration
@inject IUserContextService UserContextService
@inject IFeatureFlagService FeatureFlagService
@{
    var userKey = UserContextService.GetOrCreateUserKey(Context);
    var useReactMigration = MigrationOptions.Value.UseReactMigration && FeatureFlagService.UseReactMigration(userKey);
    var reactBaseUrl = Configuration["ReactAppBaseUrl"] ?? "http://localhost:5173";
    var careersHref = useReactMigration ? $"{reactBaseUrl}/app/careers?ldUserKey={Uri.EscapeDataString(userKey)}" : Url.Action("Index", "Careers");
    var profileHref = useReactMigration ? $"{reactBaseUrl}/app/profile?ldUserKey={Uri.EscapeDataString(userKey)}" : Url.Action("Index", "Profile");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OffOn</title>

    @* window.AB_TEST_DATA is injected first-in-head by AbTestMiddleware (server-side).
       Scripts below read it synchronously — no extra round-trip needed on .NET pages. *@

    @*
        STEP 1 — Set VWO visitor ID to the LaunchDarkly user key BEFORE
        the SmartCode loads so VWO and LD bucket the same user identically.
    *@
    <script>
        // Use the server-injected LD user key as VWO's visitor ID so both
        // systems bucket the same user identically across sessions.
        if (window.AB_TEST_DATA && window.AB_TEST_DATA.user_id) {
            var _vwo_visitor_id = window.AB_TEST_DATA.user_id;
        }
    </script>

    <!-- Start VWO Async SmartCode -->
    <link rel="preconnect" href="https://dev.visualwebsiteoptimizer.com" />
